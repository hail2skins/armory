# The Virtual Armory - Environment Configuration Example
# Copy this file to .env for local development, or mirror the keys in Railway.
# Keep real secrets out of this file. Use placeholders only.

# ============================================
# Database (PostgreSQL for local/dev/prod)
# ============================================
# Railway can provide DATABASE_URL directly. If DATABASE_URL is set, the app uses it first.
DATABASE_URL="${{Postgres.DATABASE_URL}}"
DB_HOST="postgres.railway.internal"
DB_PORT="5432"
DB_DATABASE="${{POSTGRES_DB}}"
DB_USERNAME="${{POSTGRES_USER}}"
DB_PASSWORD="${{POSTGRES_PASSWORD}}"
DB_SCHEMA="public"
DB_SSLMODE="disable"
GORM_LOG_LEVEL="silent"

# Railway Postgres plugin variables. These are useful for service wiring and CLI access.
PGDATA="${{Postgres.PGDATA}}"
PGDATABASE="${{Postgres.PGDATABASE}}"
PGHOST="${{Postgres.PGHOST}}"
PGPASSWORD="${{Postgres.PGPASSWORD}}"
PGPORT="${{Postgres.PGPORT}}"
PGUSER="${{Postgres.PGUSER}}"
POSTGRES_DB="railway"
POSTGRES_PASSWORD="replace-with-postgres-password"
POSTGRES_USER="postgres"

# ============================================
# Server Configuration
# ============================================
PORT="3000"
HOST="0.0.0.0"
ENV="development"
APP_ENV="development"
GO_ENV="development"
GIN_MODE="debug"
APP_BASE_URL="https://your-dev-app.up.railway.app"
SITE_HOST="https://your-dev-app.up.railway.app"
CORS_ORIGINS="https://your-dev-app.up.railway.app"

# ============================================
# Authentication & Security
# ============================================
ADMIN_EMAIL="support@example.com"
CASBIN_ADMIN="support@example.com"
SESSION_SECRET="replace-with-long-random-session-secret"
JWT_SECRET="replace-with-long-random-jwt-secret"
CSRF_SECRET="replace-with-long-random-csrf-secret"

# ============================================
# Stripe
# ============================================
STRIPE_SECRET_KEY="replace-with-stripe-secret-key"
STRIPE_PUBLISHABLE_KEY="replace-with-stripe-publishable-key"
STRIPE_WEBHOOK_SECRET="replace-with-stripe-webhook-secret"
STRIPE_PRICE_MONTHLY="prod_monthly_id"
STRIPE_PRICE_YEARLY="prod_yearly_id"
STRIPE_PRICE_LIFETIME="prod_lifetime_id"
STRIPE_PRICE_PREMIUM_LIFETIME="prod_premium_lifetime_id"
STRIPE_LINK_MONTHLY="https://buy.stripe.com/test_replace_monthly"
STRIPE_LINK_YEARLY="https://buy.stripe.com/test_replace_yearly"
STRIPE_LINK_LIFETIME="https://buy.stripe.com/test_replace_lifetime"
STRIPE_LINK_PREMIUM="https://buy.stripe.com/test_replace_premium"
STRIPE_IP_FILTER_ENABLED="false"
STRIPE_OVERRIDE_SECRET="replace-with-optional-override-secret"
STRIPE_TAX_ENABLED="true"

# ============================================
# Mailjet
# ============================================
MAILJET_API_KEY="replace-with-mailjet-api-key"
MAILJET_SECRET_KEY="replace-with-mailjet-secret-key"
MAILJET_SENDER_EMAIL="no-reply@example.com"
MAILJET_SENDER_NAME="The Virtual Armory"

# ============================================
# New Relic
# ============================================
NEW_RELIC_LICENSE_KEY="replace-with-new-relic-license-key"
NEW_RELIC_APP_NAME="thevirtualarmory"

# ============================================
# Test-only Variables (unit tests use SQLite)
# ============================================
DB_DRIVER="sqlite"
DB_NAME=":memory:"